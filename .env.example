# Copy to .env for local use (`npm run dev`). On Vercel, add the same keys under
# Project → Settings → Environment Variables.

# --- Sign-in (Firebase Authentication, Google) ---------------------------------
# Only these Google accounts can use the app (comma separated).
ALLOWED_EMAILS=you@gmail.com
# Firebase console → Project settings → General → Your apps → Web app config.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_APP_ID=
# ...or instead of the three above, paste the whole `const firebaseConfig = {...}`
# snippet from that page as one variable:
# FIREBASE_WEB_CONFIG=

# --- Database (Cloud Firestore) --------------------------------------------------
# Optional when FIREBASE_SERVICE_ACCOUNT is set (read from the key file).
FIREBASE_PROJECT_ID=your-project
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line, or base64 of it (base64 -w0 key.json).
FIREBASE_SERVICE_ACCOUNT=

# Encrypts the bank access tokens stored in Firestore. Any long random string,
# e.g. `openssl rand -base64 32`. Don't change it later (you'd have to reconnect).
TOKEN_ENCRYPTION_KEY=

# --- Chase via Plaid (recommended) ----------------------------------------------
# dashboard.plaid.com → Developers → Keys. Use the Trial plan's Production secret
# to connect your real Chase login; "sandbox" only has test banks.
PLAID_CLIENT_ID=
PLAID_SECRET=
# production (default) = your real bank; sandbox = Plaid's test banks. Each has
# its own secret in the Plaid dashboard, so PLAID_SECRET must match this.
PLAID_ENV=production
# Only needed for Chase's OAuth flow on phones: your app URL, also added under
# Plaid Dashboard → Developers → API → Allowed redirect URIs.
# PLAID_REDIRECT_URI=https://your-app.vercel.app/
# How much history to pull on first connect (30-730 days).
# PLAID_DAYS_REQUESTED=365

# --- Daily sync (Vercel Cron) ---------------------------------------------------
# Vercel sends this automatically to /api/cron/sync. Any long random string.
CRON_SECRET=

# --- Optional ---------------------------------------------------------------------
# APP_NAME=Reimbursement Tracker
# BANK_TIMEZONE=America/New_York
# Local only: skip Google sign-in (never allowed on Vercel).
# AUTH_DISABLED=1
# LOCAL_USER_ID=local
# Local Firestore emulator instead of the real database:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
